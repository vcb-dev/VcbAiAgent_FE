# Backend (Node/BE) that proxies the studio endpoints to the AI service.
VITE_BE_PROXY=http://127.0.0.1:3011

# AI service that serves rendered media under /media.
VITE_MEDIA_PROXY=http://localhost:8787

# Base path for API calls. Relative on purpose so the dev proxy handles routing.
VITE_API_BASE=/api/v1
